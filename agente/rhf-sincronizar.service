# El sincronizador de conversaciones del agente con el CRM (7-oct-2026).
# Unidad de usuario de systemd: va en ~/.config/systemd/user/ del usuario que
# es dueño de ~/.hermes (ver agente/LEEME.md). La activa rhf-sincronizar.timer.
[Unit]
Description=RHF: manda al CRM las conversaciones nuevas del agente de atención
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Solo el token (una línea RHF_CONVERSACIONES_TOKEN=…), en un archivo propio
# con permisos 600: el servicio no carga el .env del agente con sus otras claves.
EnvironmentFile=%h/.config/rhf-sincronizar/token.env
Environment=RHF_HERMES_DB=%h/.hermes/profiles/atencion/state.db
Environment=RHF_SINCRONIZAR_ESTADO=%h/.local/state/rhf-sincronizar/estado.json
# Para probar contra la vista previa antes de publicar, cambiar por la URL de
# la vista previa (escribe en rhf-leads-preview, no en producción).
Environment=RHF_CONVERSACIONES_URL=https://rhfliving.com/api/conversaciones-agente
ExecStart=/usr/bin/env python3 %h/.local/share/rhf-sincronizar/sincronizar_conversaciones.py
TimeoutStartSec=150
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
