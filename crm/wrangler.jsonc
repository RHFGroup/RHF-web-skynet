{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // El CRM interno de RHF (1-oct-2026, Prompt 3 de Luciano, fase 2). Es un
  // Worker aparte del sitio, con su propia dirección: crm.rhfliving.com. Así
  // nada del CRM viaja en lo que descarga el público, y una falla de uno no
  // tumba al otro. Lee y escribe en la misma base que el sitio (rhf-leads).
  //
  // Se publica igual que el sitio: con el merge a master, por su propio
  // proyecto de Workers Builds (ver crm/README.md). Nunca con `wrangler deploy`
  // desde el Mac.
  "name": "rhf-crm",
  "compatibility_date": "2026-09-10",
  // El alias @/ de src/data lo resuelve esbuild con crm/tsconfig.json, que
  // encuentra solo (no va en "tsconfig": wrangler lo busca mal con -c).
  "main": "./src/index.ts",

  // La dirección crm.rhfliving.com no va acá: se agrega una sola vez en el
  // panel (dominio propio del Worker, más una ruta sin Worker para que la ruta
  // comodín *.rhfliving.com/* del sitio no se la coma). Ver crm/README.md.
  // Así el deploy no depende de los permisos del token de Workers Builds sobre
  // la zona.

  // Sin dirección pública en workers.dev. Las vistas previas de Workers Builds
  // sí tienen la suya: piden el mismo código de acceso y usan la base de
  // pruebas (ver `baseDe` en src/base.ts).
  "workers_dev": false,
  "preview_urls": true,

  // La hoja de estilos, el script y las fuentes del CRM. `run_worker_first`
  // hace que todo pase primero por el Worker, que exige sesión antes de
  // entregar cualquier cosa (salvo lo que necesita la página de acceso).
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // El resumen del día por Telegram: todos los días a las 7:30 a. m. de
  // Colombia (12:30 UTC). Las vistas previas no corren crons.
  "triggers": {
    "crons": ["30 12 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhf-leads",
      "database_id": "961a8a5d-0a87-48f7-986c-5e22e5394ea3",
      "migrations_dir": "../migrations"
    },
    {
      "binding": "DB_PREVIEW",
      "database_name": "rhf-leads-preview",
      "database_id": "b036a63d-37cf-44c3-bab0-fdb210bf25e8",
      "migrations_dir": "../migrations"
    }
  ],

  // Los avisos de Telegram salen por el Worker del sitio, que ya tiene el bot
  // configurado (`Avisos` en worker/index.ts). Así el CRM no necesita una copia
  // de los secretos.
  "services": [
    { "binding": "AVISOS", "service": "rhf-web-skynet", "entrypoint": "Avisos" }
  ],

  // Solo las líneas que el CRM escribe a propósito, sin datos personales. Los
  // registros automáticos de cada petición (con la IP y los encabezados)
  // quedan apagados.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
